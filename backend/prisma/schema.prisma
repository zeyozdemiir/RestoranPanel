generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  plan      String   @default("Demo")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  dashboardStats       DashboardStat[]
  dashboardRevenueBars DashboardRevenueBar[]
  dashboardActions     DashboardAction[]
  dailyReports         DailyReport[]
  uploadedDocuments    UploadedDocument[]
  expenses             Expense[]
  suppliers            Supplier[]
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("Restaurant Admin")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  uploadedDocuments UploadedDocument[]
}

model DashboardStat {
  id        Int      @id @default(autoincrement())
  title     String
  value     String
  note      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
}

model DashboardRevenueBar {
  id        Int      @id @default(autoincrement())
  label     String
  value     String
  height    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
}

model DashboardAction {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  status      String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
}

model DailyReport {
  id               Int      @id @default(autoincrement())
  reportDate       DateTime
  revenue          Float    @default(0)
  reservationCount Int      @default(0)
  openTaskCount    Int      @default(0)
  cashDifference   Float    @default(0)
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, reportDate])
}

model UploadedDocument {
  id           Int      @id @default(autoincrement())
  originalName String
  storedName   String
  mimeType     String
  sizeBytes    Int
  path         String

  documentType String   @default("ADISYON_REPORT")
  status       String   @default("UPLOADED")

  aiRead       Boolean  @default(false)
  processed    Boolean  @default(false)

  extractedData String?
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  uploadedByUserId Int
  uploadedByUser   User @relation(fields: [uploadedByUserId], references: [id])

  expenses Expense[]
}

model Expense {
  id Int @id @default(autoincrement())

  supplierName String @default("AI okuma bekliyor")
  invoiceNo    String?
  invoiceDate  DateTime?

  category      String @default("Fatura")
  description   String?
  netAmount     Float  @default(0)
  taxAmount     Float  @default(0)
  totalAmount   Float  @default(0)
  currency      String @default("TRY")

  paymentStatus String @default("UNPAID")
  status        String @default("DRAFT")
  source        String @default("UPLOAD")

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  uploadedDocumentId Int?
  uploadedDocument   UploadedDocument? @relation(fields: [uploadedDocumentId], references: [id])
}

model Supplier {
  id          Int      @id @default(autoincrement())
  name        String
  taxNumber   String?
  iban        String?
  phone       String?
  email       String?
  address     String?
  category    String   @default("Genel")
  contactName String?
  note        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
}
